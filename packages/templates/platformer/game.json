  "scripts": [
    {
      "id": "player-controller",
      "name": "PlayerController",
      "code": "-- Player Controller Script\n-- WASD/Arrow keys to move\n-- Space to jump\n\nlocal moveSpeed = 6\nlocal jumpForce = 7\nlocal isGrounded = false\nlocal jumpCount = 0\nlocal maxJumps = 1\nlocal velocity = {x=0, y=0, z=0}\n\nfunction update(dt)\n  -- Read input\n  local moveX = 0\n  local moveZ = 0\n  \n  if input.forward then moveZ = moveZ - 1 end\n  if input.backward then moveZ = moveZ + 1 end\n  if input.left then moveX = moveX - 1 end\n  if input.right then moveX = moveX + 1 end\n  \n  -- Normalize movement\n  local moveLen = math.sqrt(moveX*moveX + moveZ*moveZ)\n  if moveLen > 0 then\n    moveX = moveX / moveLen\n    moveZ = moveZ / moveLen\n  end\n  \n  -- Apply movement\n  velocity.x = moveX * moveSpeed\n  velocity.z = moveZ * moveSpeed\n  \n  -- Handle jumping\n  if input.jump and isGrounded then\n    velocity.y = jumpForce\n    isGrounded = false\n    jumpCount = jumpCount + 1\n  end\n  \n  -- Apply gravity\n  velocity.y = velocity.y - 9.81 * dt\n  \n  -- Apply damping\n  velocity.x = velocity.x * 0.99\n  velocity.z = velocity.z * 0.99\nend\n\nfunction onCollision(other)\n  print(\"Collided with \" .. other.name)\n  if other.name == \"Goal\" then\n    print(\"Victory!\")\n  end\nend"
    }
  ],
